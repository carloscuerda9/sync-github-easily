{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ifschpokjtzwbxiskyfx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "we-fix-you",
      "version": "0.2.0",
      "title": "WE FIX YOU"
    },
    "tools": [
      {
        "name": "list_my_appointments",
        "title": "Listar mis citas",
        "description": "Lista las citas próximas del usuario autenticado en WE FIX YOU. Devuelve JSON estructurado {ok,count,club_id,data,message}.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Máximo de citas a devolver (por defecto 10)"
            },
            "club_id": {
              "type": "string",
              "format": "uuid",
              "description": "Solo para owner/superadmin sin club propio: club de contexto. Se ignora para el resto de roles."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_club_players",
        "title": "Listar jugadores del club",
        "description": "Lista los jugadores aprobados del club del usuario autenticado. Solo disponible para fisios, entrenadores y administradores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Máximo de jugadores a devolver (por defecto 50)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_player_status",
        "title": "Estado de un jugador",
        "description": "Devuelve el color de estado asignado por los fisios a un jugador (verde, amarillo, naranja o rojo).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID del jugador"
            }
          },
          "required": [
            "player_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_message",
        "title": "Enviar mensaje",
        "description": "Envía un mensaje a otro usuario del mismo club. Solo permite mensajes entre usuarios del mismo club.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "receiver_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID del destinatario"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Contenido del mensaje"
            }
          },
          "required": [
            "receiver_id",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_match_minutes",
        "title": "Registrar minutos jugados",
        "description": "Registra (o actualiza) los minutos jugados por un jugador en un partido. Solo fisios, entrenadores y administradores del mismo club.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID del jugador"
            },
            "match_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha del partido (YYYY-MM-DD)"
            },
            "minutes_played": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Minutos jugados"
            },
            "opponent": {
              "type": "string",
              "maxLength": 120,
              "description": "Rival"
            },
            "competition": {
              "type": "string",
              "maxLength": 120,
              "description": "Competición (liga, copa, amistoso…)"
            },
            "started": {
              "type": "boolean",
              "description": "¿Fue titular?"
            },
            "notes": {
              "type": "string",
              "maxLength": 1000,
              "description": "Notas u observaciones"
            }
          },
          "required": [
            "player_id",
            "match_date",
            "minutes_played"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_match_minutes",
        "title": "Consultar minutos jugados",
        "description": "Consulta los minutos jugados registrados, con filtros opcionales por jugador y rango de fechas. Devuelve también el total acumulado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtrar por jugador"
            },
            "from_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Desde (YYYY-MM-DD)"
            },
            "to_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Hasta (YYYY-MM-DD)"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de registros (por defecto 50)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_injury",
        "title": "Registrar lesión",
        "description": "Registra una lesión de un jugador en el histórico clínico (zona del cuerpo, tipo, gravedad, tratamiento y días de recuperación). Solo fisios y administradores del mismo club.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID del jugador"
            },
            "injury_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha de la lesión (YYYY-MM-DD)"
            },
            "body_part": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Zona del cuerpo afectada"
            },
            "injury_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Tipo de lesión (muscular, ligamentosa, ósea…)"
            },
            "severity": {
              "type": "string",
              "enum": [
                "leve",
                "moderada",
                "grave"
              ],
              "description": "Gravedad"
            },
            "treatment": {
              "type": "string",
              "maxLength": 1000,
              "description": "Tratamiento aplicado"
            },
            "recovery_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 730,
              "description": "Días estimados de recuperación"
            },
            "notes": {
              "type": "string",
              "maxLength": 1000,
              "description": "Observaciones"
            }
          },
          "required": [
            "player_id",
            "injury_date",
            "body_part",
            "injury_type"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_injuries",
        "title": "Consultar lesiones",
        "description": "Consulta las lesiones registradas en el histórico clínico, con filtros opcionales por jugador y rango de fechas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtrar por jugador"
            },
            "from_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Desde (YYYY-MM-DD)"
            },
            "to_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Hasta (YYYY-MM-DD)"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de registros (por defecto 50)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
